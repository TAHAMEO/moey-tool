# Keep secrets, runtime data and local build output out of images.
.git
.env
.env.*
!.env.example
var/
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
backend/.venv
backend/tests
workers/**/.venv
frontend/node_modules
frontend/.next
frontend/out
frontend/test-results
frontend/playwright-report
frontend/*.tsbuildinfo
frontend/next-env.d.ts
docs/
sbom/
