# CLIPFORGE AI configuration. Copy to .env (scripts/install.sh does this and fills in the secrets).
# Never commit .env. Empty values mean "not set".

# --------------------------------------------------------------------------- required
# Database password for the bundled PostgreSQL.
POSTGRES_PASSWORD=
# Encrypts every stored API key and OAuth token (AES-256-GCM). Generate: docker compose run --rm api clipforge gen-key
# BACK IT UP: without it, stored keys and tokens cannot be decrypted.
CLIPFORGE_MASTER_KEY=
# During a key rotation: the old key(s), comma separated, so existing secrets stay readable.
CLIPFORGE_MASTER_KEY_PREVIOUS=

# --------------------------------------------------------------------------- address
# The URL people use to open CLIPFORGE. OAuth redirect URIs are derived from it
# (<url>/api/connections/google/callback and <url>/api/connections/instagram/callback).
CLIPFORGE_PUBLIC_BASE_URL=http://localhost:3000
# Port for plain HTTP on this machine (the bundled Caddy front door).
CLIPFORGE_HTTP_PORT=3000
# For HTTPS with an automatic Let's Encrypt certificate set a domain name that points here,
# CLIPFORGE_HTTP_PORT=80, CLIPFORGE_HTTPS_PORT=443 and CLIPFORGE_PUBLIC_BASE_URL=https://<domain>.
CLIPFORGE_SITE_ADDRESS=
CLIPFORGE_HTTPS_PORT=3443
# Only when serving plain HTTP on an address other than localhost (browsers drop
# "Secure" cookies there). Use HTTPS instead whenever the server is reachable from the internet.
CLIPFORGE_COOKIE_SECURE=

# --------------------------------------------------------------------------- YouTube / Google
# OAuth client (Web application) from Google Cloud Console; see docs/API_SETUP.md.
CLIPFORGE_GOOGLE_CLIENT_ID=
CLIPFORGE_GOOGLE_CLIENT_SECRET=
# Optional: API key for reading public video metadata of videos you don't own.
CLIPFORGE_YOUTUBE_API_KEY=

# --------------------------------------------------------------------------- Instagram
# Meta app with "Instagram API with Instagram Login"; see docs/API_SETUP.md.
CLIPFORGE_META_APP_ID=
CLIPFORGE_META_APP_SECRET=

# --------------------------------------------------------------------------- live streams
# Hostname or IP your streaming encoder (OBS) uses to reach this server.
CLIPFORGE_LIVE_PUBLIC_HOST=localhost
# UDP ports for authorised SRT live ingest (4 parallel sessions).
CLIPFORGE_LIVE_PORTS=9000-9003

# --------------------------------------------------------------------------- storage
# local (Docker volume) or s3 (any S3-compatible object storage).
CLIPFORGE_STORAGE_BACKEND=local
CLIPFORGE_S3_ENDPOINT_URL=
CLIPFORGE_S3_BUCKET=
CLIPFORGE_S3_REGION=
CLIPFORGE_S3_ACCESS_KEY_ID=
CLIPFORGE_S3_SECRET_ACCESS_KEY=

# --------------------------------------------------------------------------- capacity
# Parallel media workers. Each processes one job at a time and needs about 5.5 GB RAM once the
# speech model is loaded (measured with vosk-model-en-us-0.22), plus 2 CPU cores for rendering.
CLIPFORGE_MEDIA_WORKERS=1
CLIPFORGE_LOG_LEVEL=INFO

# --------------------------------------------------------------------------- outbound TLS proxy
# Only if this server reaches the internet through a TLS-inspecting proxy: path *inside the
# containers* to a CA bundle that includes the proxy's certificate (mount it via
# docker-compose.override.yml; see docs/DEPLOYMENT.md).
CLIPFORGE_EXTRA_CA_FILE=
