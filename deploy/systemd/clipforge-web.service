[Unit]
Description=CLIPFORGE web app
After=network-online.target clipforge-api.service

[Service]
User=clipforge
Group=clipforge
WorkingDirectory=/opt/clipforge/frontend/.next/standalone
Environment=NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
